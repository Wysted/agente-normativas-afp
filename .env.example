APP_ENV=local
POSTGRES_USER=agintis
POSTGRES_PASSWORD=agintis
POSTGRES_DB=agintis
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://agintis:agintis@localhost:5432/agintis

# Hugging Face TEI (CPU): models download on first start into the hf_cache volume
EMBEDDINGS_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDINGS_PORT=8081
RERANKER_PORT=8082
# App on host; inside compose the app uses http://embeddings:80 and http://reranker:80
EMBEDDINGS_URL=http://localhost:8081
RERANKER_URL=http://localhost:8082
